# ==============================================================================
# WhatsApp REST API Gateway — Environment Configuration Example
# Copy this file to .env and configure as needed: cp .env.example .env
# ==============================================================================

# Server Network Settings
PORT=7860
HOST=0.0.0.0
NODE_ENV=development

# WhatsApp Engine Selection
# Options: 'baileys' (embedded standalone engine) or 'evolution' (remote API)
WHATSAPP_ENGINE=baileys

# Database & Persistent Storage (Optional MongoDB Connection)
# - Leave blank: The gateway uses local JSON files in the ./data directory (default).
# - Provide URI: The gateway links directly with MongoDB, storing WhatsApp sessions,
#   API tokens, activity logs, admin secrets, and webhook settings in MongoDB.
#   Any existing local data in ./data will be automatically migrated to MongoDB on first boot!
#   Ideal for container platforms with ephemeral storage (Render, Hugging Face Spaces, Fly.io, etc.).
# Examples:
#   MONGODB_URI=mongodb://localhost:27017/whatsapp_gateway
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/whatsapp_gateway?retryWrites=true&w=majority
MONGODB_URI=
# Optional database name override (defaults to 'whatsapp_gateway' or database specified in MONGODB_URI)
MONGODB_DB_NAME=whatsapp_gateway

# Baileys Session Credentials Path (Used as local fallback when MONGODB_URI is blank)
SESSION_DATA_PATH=./data/auth_info

# Master Admin Authentication
# Required to access the Web Cockpit, create/revoke tokens, view QR codes, and read logs.
# If left empty, a secure random key will be generated on first boot and printed to container logs.
ADMIN_API_KEY=

# Rate Limiting Guard (General messaging per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Master Admin Authentication Rate Limiting (Brute-force protection)
ADMIN_RATE_LIMIT_MAX=30
ADMIN_RATE_LIMIT_WINDOW_MS=900000

# Whitelist / Default Recipient Phone Number (digits only with country code)
# Used in automated test suites and displayed as the placeholder throughout the Web App
WHITELIST_PHONE_NUMBER=200000000000

# Outbound Webhook Delivery
# Forward incoming messages and message status delivery receipts
WEBHOOK_URL=
WEBHOOK_SECRET=

# Evolution API Engine Settings (Applicable only if WHATSAPP_ENGINE=evolution)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=my-super-secret-key-123456
INSTANCE_NAME=test-bot
