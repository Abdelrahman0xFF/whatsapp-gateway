# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=7860
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. WhatsApp Engine & Storage
# ------------------------------------------------------------------------------
# Active engine: 'baileys' (standalone 1-container embedded) or 'evolution' (remote)
WHATSAPP_ENGINE=baileys

# Local folder path for persisting Baileys multi-device credentials
SESSION_DATA_PATH=./data/auth_info

# Optional default recipient number for testing (digits with country code, e.g. 201012345678)
RECIPIENT_NUMBER=

# ------------------------------------------------------------------------------
# 3. Security & API Authentication
# ------------------------------------------------------------------------------
# Static API key(s) fallback. You can provide one key or comma-separated keys.
# Note: You can also generate and manage keys dynamically via the Dashboard or POST /api/tokens/generate.
# If left blank and no tokens exist, gateway operates in open mode.
GATEWAY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Rate Limiting (Spam & Bombing Safeguards)
# ------------------------------------------------------------------------------
# Max requests allowed within the time window
RATE_LIMIT_MAX=60

# Rate limit time window in milliseconds (60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. Outbound Webhook Delivery (Two-Way Messaging & Receipts)
# ------------------------------------------------------------------------------
# External URL where incoming messages and delivery receipts will be POSTed
# (Leave blank to disable outbound webhooks)
WEBHOOK_URL=

# Optional secret key used to sign webhook payloads with HMAC-SHA256 (X-Hub-Signature-256)
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. Remote Evolution API Engine (Only required when WHATSAPP_ENGINE=evolution)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=my-super-secret-key-123456
INSTANCE_NAME=test-bot
