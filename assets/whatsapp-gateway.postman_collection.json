{
  "info": {
    "_postman_id": "c1f7b022-83b6-4b89-a29d-whatsapp-gateway",
    "name": "WhatsApp REST API Gateway",
    "description": "Production Postman Collection for the WhatsApp REST API Gateway. Includes all endpoints for sending messages, rich media dispatch (images, documents, audio, video), bulk messaging, OTP verification, API token lifecycle management, webhooks, activity audit feed, QR & phone number pairing, and container health monitoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7860",
      "type": "string",
      "description": "Base URL of the deployed gateway (e.g. http://localhost:7860 or https://your-space.hf.space)"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "Client API Key (wa_live_...) generated via Token Studio for downstream microservices to send messages and OTPs"
    },
    {
      "key": "adminKey",
      "value": "",
      "type": "string",
      "description": "Master Admin Key (ADMIN_API_KEY or adm_live_...) required to manage tokens, pairing codes, QR codes, webhooks, and audit logs"
    },
    {
      "key": "recipientNumber",
      "value": "201012345678",
      "type": "string",
      "description": "Configured whitelist phone number with country code (e.g. from WHITELIST_PHONE_NUMBER)"
    },
    {
      "key": "tokenId",
      "value": "tok_123456",
      "type": "string",
      "description": "Token ID for revocation tests"
    },
    {
      "key": "activityId",
      "value": "act_123456",
      "type": "string",
      "description": "Activity log entry ID for single deletion tests (e.g. act_...)"
    }
  ],
  "item": [
    {
      "name": "Messages",
      "description": "Endpoints to dispatch single text, bulk messages, and rich media (images, PDFs, documents, audio voice notes, video) to any WhatsApp number.",
      "item": [
        {
          "name": "Send Single Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text",
                "description": "API key generated via Token Studio (/api/tokens)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"message\": \"Hello from WhatsApp REST Gateway! 🚀\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "send"]
            },
            "description": "Sends a single WhatsApp text message to the specified recipient phone number."
          },
          "response": []
        },
        {
          "name": "Send Media Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"type\": \"document\",\n  \"mediaUrl\": \"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\",\n  \"fileName\": \"Invoice_1042.pdf\",\n  \"caption\": \"Here is your monthly invoice statement.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/send-media",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "send-media"]
            },
            "description": "Dispatches an image, document/PDF, audio voice note, or video attachment via remote URL or Base64 with optional caption. Media URLs are protected by SSRF validation (internal/private/metadata IPs rejected). Maximum file size limit: 25MB (streamed safely)."
          },
          "response": []
        },
        {
          "name": "Send Single Message (Convenience Alias)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"message\": \"Hello via convenience alias endpoint!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/send-message",
              "host": ["{{baseUrl}}"],
              "path": ["api", "send-message"]
            },
            "description": "Top-level direct alias endpoint for sending messages."
          },
          "response": []
        },
        {
          "name": "Send Bulk Messages (Synchronous)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": [\n    \"{{recipientNumber}}\",\n    \"15551234567\"\n  ],\n  \"message\": \"System update: Scheduled maintenance tonight at 10 PM UTC.\",\n  \"delayMs\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/send-bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "send-bulk"]
            },
            "description": "Dispatches a message sequentially to an array of recipients with anti-ban jitter delays."
          },
          "response": []
        },
        {
          "name": "Send Bulk Messages (Async Background Queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"number\": \"{{recipientNumber}}\",\n      \"message\": \"Customer Notice A: Order #1042 shipped!\"\n    },\n    {\n      \"number\": \"15551234567\",\n      \"message\": \"Customer Notice B: Appointment reminder for tomorrow.\"\n    }\n  ],\n  \"async\": true,\n  \"delayMs\": 1500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/send-bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "send-bulk"]
            },
            "description": "Enqueues bulk messages for asynchronous background execution. Immediately returns HTTP 202 Accepted with a batchId to prevent proxy/gateway timeouts."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Master Admin & Security Governance",
      "description": "Endpoints protected by the Master Admin Key (ADMIN_API_KEY). Used for dashboard authentication, key verification, and privileged management.",
      "item": [
        {
          "name": "Verify Master Admin Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{adminKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "verify"]
            },
            "description": "Validates Master Admin Key during dashboard authentication or external administrative workflows. Enforces rate limiting (max 30 attempts per 15-minute window). Returns success confirmation, key source, and masked identifier."
          },
          "response": []
        },
        {
          "name": "Check Admin Session Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "status"]
            },
            "description": "Checks if the caller possesses an active Master Admin session and returns key metadata, whitelist phone configuration, and storage topology."
          },
          "response": []
        }
      ]
    },
    {
      "name": "API Token Governance",
      "description": "Generate, list, and revoke cryptographically secure API keys (wa_live_...) with timing-safe SHA-256 validation.",
      "item": [
        {
          "name": "Generate New API Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for token governance)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production CRM Backend\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tokens/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tokens", "generate"]
            },
            "description": "Generates a new cryptographically secure token starting with 'wa_live_'. Returns plain-text token once."
          },
          "response": []
        },
        {
          "name": "List Active Tokens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for token governance)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tokens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tokens"]
            },
            "description": "Retrieves metadata for all active tokens with masked secrets, creation dates, and last usage timestamps."
          },
          "response": []
        },
        {
          "name": "Revoke API Token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for token governance)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tokens/{{tokenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tokens", "{{tokenId}}"]
            },
            "description": "Immediately invalidates and revokes an API token by its unique ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Webhooks & Event Dispatch",
      "description": "Configure outbound webhook delivery for incoming WhatsApp messages and delivery receipts with HMAC-SHA256 signature verification.",
      "item": [
        {
          "name": "Get Webhook Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for webhook management)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "status"]
            },
            "description": "Checks whether an external webhook URL is active and retrieves event delivery statistics."
          },
          "response": []
        },
        {
          "name": "Configure Webhook URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for webhook management)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/api/whatsapp-webhook\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/configure",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "configure"]
            },
            "description": "Dynamically sets or clears the external webhook URL for receiving incoming messages and delivery receipts."
          },
          "response": []
        },
        {
          "name": "Test Webhook Dispatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for webhook management)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "test"]
            },
            "description": "Dispatches a synthetic ping event to the configured webhook URL to verify network connectivity and signature verification."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Activity & Audit Feed",
      "description": "Inspect and manage real-time rolling dispatch history, message IDs, latency, delivery statuses, pagination, and audit log entries.",
      "item": [
        {
          "name": "Get Activity Logs (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for audit logs)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/activity?page=1&limit=10&type=ALL&status=ALL&search=2010",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number to retrieve (starts at 1, default 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of activities per page (1-100, default 10)"
                },
                {
                  "key": "type",
                  "value": "ALL",
                  "description": "Filter by message type: ALL, TEXT, MEDIA, OTP_SEND, OTP_VERIFY"
                },
                {
                  "key": "status",
                  "value": "ALL",
                  "description": "Filter by delivery status: ALL, SENT, FAILED, VERIFIED"
                },
                {
                  "key": "search",
                  "value": "2010",
                  "disabled": true,
                  "description": "Search query across recipient phone, preview, error trace, or message ID"
                }
              ]
            },
            "description": "Returns a paginated list of gateway transmissions with pagination metadata (page, limit, total, totalPages, hasNext, hasPrev), delivery stats, and filtered records."
          },
          "response": []
        },
        {
          "name": "Delete Single Activity Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for audit logs)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/activity/{{activityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity", "{{activityId}}"]
            },
            "description": "Deletes a specific activity log record by its unique ID (e.g. act_...). Returns 200 on success or 404 if not found."
          },
          "response": []
        },
        {
          "name": "Clear All Activity Logs",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for audit logs)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/activity/clear",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity", "clear"]
            },
            "description": "Resets and permanently clears all activity audit records from gateway storage."
          },
          "response": []
        }
      ]
    },
    {
      "name": "OTP Verification",
      "description": "Cryptographically secure one-time password generation and verification flows with expiration TTL and anti-bombing cooldowns.",
      "item": [
        {
          "name": "Request / Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"appName\": \"My SaaS Platform\",\n  \"length\": 6,\n  \"expiresInMinutes\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "otp", "send"]
            },
            "description": "Generates a 6-digit numeric OTP, enforces a 45-second per-number anti-bombing cooldown, and dispatches via WhatsApp."
          },
          "response": []
        },
        {
          "name": "Request OTP (Alias: /api/otp/request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text",
                "description": "Client API Token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"appName\": \"My SaaS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "otp", "request"]
            },
            "description": "Convenience endpoint alias for requesting/sending a 6-digit OTP passcode to a phone number."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "otp", "verify"]
            },
            "description": "Verifies user-submitted 6-digit OTP. Returns 200 VERIFIED or 400 with attempts left."
          },
          "response": []
        }
      ]
    },
    {
      "name": "WhatsApp Instance & Device Linking",
      "description": "Manage the WhatsApp connection state, QR codes, phone number pairing codes, and session logout.",
      "item": [
        {
          "name": "Get Connection Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key or Client Token (x-api-key: {{apiKey}})"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instance/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "status"]
            },
            "description": "Returns current connection state: 'open' (connected), 'connecting', or 'disconnected'. When authenticated with Master Admin Key, includes whitelist phone and detailed storage info."
          },
          "response": []
        },
        {
          "name": "Get QR Code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for device pairing & instance lifecycle)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instance/qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "qr"]
            },
            "description": "Fetches current QR code as base64 Data URL and raw code for camera scanning."
          },
          "response": []
        },
        {
          "name": "Request 8-Digit Pairing Code (Phone Number Link)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for device pairing & instance lifecycle)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{recipientNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/instance/pairing-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "pairing-code"]
            },
            "description": "Requests an 8-character pairing code (e.g. WXYZ-1234) to link phone directly without using a camera."
          },
          "response": []
        },
        {
          "name": "Trigger Reconnect",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for device pairing & instance lifecycle)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instance/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "connect"]
            },
            "description": "Forces instance to connect or generate a fresh QR code."
          },
          "response": []
        },
        {
          "name": "Restart Instance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for device pairing & instance lifecycle)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instance/restart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "restart"]
            },
            "description": "Restarts the internal WhatsApp socket connection."
          },
          "response": []
        },
        {
          "name": "Logout / Unlink Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Master Admin Key (required for device pairing & instance lifecycle)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instance/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instance", "logout"]
            },
            "description": "Unlinks current WhatsApp account, deletes session files, and prepares for a new device connection."
          },
          "response": []
        }
      ]
    },
    {
      "name": "System & Health",
      "description": "Container liveness checks and system information.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns container health status, uptime, WhatsApp engine state, active key protection, and storage status (sanitized for public monitoring with zero leaked phone numbers or database connection URIs)."
          },
          "response": []
        }
      ]
    }
  ]
}
